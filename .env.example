################################################################################
# SmartTable Frontend — variables de entorno (.env.example)
#
# Copia este archivo a `.env` y completa los valores.
# Convención:
#   [FRONT]    → las usa Vite / el código React del navegador (prefijo VITE_*)
#   [ELECTRON] → las usa Electron (main.cjs, builder, scripts). El navegador NO las lee.
#   [PASSTHRU] → Electron las lee del .env del frontend y se las pasa al backend hijo
################################################################################

# =============================================================================
# [FRONT] — Frontend React / Vite
# =============================================================================

# URL base del API que usa apiClient (todas las llamadas HTTP).
# Para: que el front sepa a dónde pegarle (/ventas, /backup, etc.).
# Si falta: fallback a "/api" (con warning en consola). Sirve con el proxy de Vite
#   o cuando el backend sirve el front en el mismo origen.
# Recomendado en este repo: /api
VITE_API_URL=/api

# Puerto del servidor de desarrollo de Vite (npm run dev / desktop:dev).
# Para: abrir el UI en http://localhost:VITE_PORT
# Si falta: fallback 5173
# Nota: Electron también la lee para esperar a que Vite esté listo.
VITE_PORT=5173

# Destino del proxy de Vite: las peticiones a /api/* se reenvían aquí.
# Para: desarrollo local sin CORS raro (el browser habla con Vite, Vite con el backend).
# Si falta: fallback http://localhost:8080
# Solo aplica con Vite en modo dev; en build/Electron empaquetado no se usa.
SMARTTABLE_API_PROXY_TARGET=http://localhost:8080

# =============================================================================
# [ELECTRON] — App de escritorio / build
# =============================================================================

# Puerto donde Electron levanta (o espera) el backend embebido.
# Para: API en http://127.0.0.1:PORT y, en producción empaquetada, servir el UI.
# Si falta: fallback 8080
PORT=8080

# Ruta al repo Backend (absoluta o relativa al Frontend).
# Para: desktop:dev, rebuild de nativos e instalador (electron-builder).
# Si falta: Electron intenta ../../SmartTable---Backend; si no existe, falla al arrancar.
# Recomendado aquí: ../SmartTable---Backend
SMARTTABLE_BACKEND_PATH=../SmartTable---Backend

# Secreto JWT que Electron pasa al backend en modo PRODUCTION.
# Para: firmar/verificar tokens de login en la app de escritorio.
# Si falta: Electron usa fallback "smarttable-desktop-secret-change-me" (cámbialo en real).
# El React del navegador NO usa esta variable.
JWT_SECRET_PRODUCTION=cambia-este-secreto-en-tu-env-local

# (Opcional) Forzar seed automático al arrancar el backend desde Electron.
# Electron ya inyecta SMARTTABLE_AUTO_SEED=1 al proceso; no hace falta ponerla aquí
# salvo que quieras documentarla. Si el backend arranca solo y no la tiene: no hace seed.
# Con BD vacía crea: usuario Administrador (PIN 1234), Salón principal (5 mesas),
# roles admin/cajero/mesero y medios de pago comunes en Colombia.
# SMARTTABLE_AUTO_SEED=1

# SMARTTABLE_DEV la pone el script npm (desktop:dev=1). No la configures a mano.
# Si falta / no es 1: Electron asume modo empaquetado o start sin Vite.

# =============================================================================
# [PASSTHRU] — OAuth Google Drive (proveedor; Electron → backend)
# =============================================================================
# El cliente de la app NO las configura. Van quemadas en tu instalación.
# Prioridad en el backend:
#   1) GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET
#   2) si faltan, GOOGLE_OAUTH_CLIENT_PATH (JSON de Cloud Console)
# Si no hay ninguna: Drive OAuth no arranca; el cliente ve mensaje genérico
#   "Google Drive aún no está disponible...".

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Alternativa al par de arriba: ruta al JSON OAuth (installed/web).
# Si ID+SECRET están definidos, esta se ignora.
# GOOGLE_OAUTH_CLIENT_PATH=

# (Opcional) URI de callback OAuth. Si falta, el backend usa:
#   http://127.0.0.1:${PORT}/api/backup/oauth/callback
# GOOGLE_OAUTH_REDIRECT_URI=
