# URL base que usa el frontend para llamar a la API. Usa /api para desarrollo, build web y Electron.
VITE_API_URL=/api

# Puerto donde Electron levanta el backend embebido. Déjalo en 8080 salvo que ese puerto esté ocupado.
PORT=8080

# Ruta absoluta o relativa al repo backend cuando trabajas en desarrollo o generas el instalador.
# Si el backend está al lado del frontend con el nombre SmartTable---Backend-nog, puedes dejarlo vacío.
SMARTTABLE_BACKEND_PATH=

# Destino del proxy de Vite en desarrollo. Solo se usa con npm run dev o npm run desktop:dev.
SMARTTABLE_API_PROXY_TARGET=http://localhost:8080

# Solo lo usa Electron (la app de escritorio): se lo pasa al backend embebido para firmar los JWT.
# El front en el navegador NO lo usa. Cámbialo por un texto largo y privado.
JWT_SECRET_PRODUCTION=cambia-este-secreto-en-tu-env-local
